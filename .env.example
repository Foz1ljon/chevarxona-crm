# MongoDB connection string (replica set required for multi-document transactions;
# the app transparently falls back to sequential writes on standalone servers)
MONGODB_URI=mongodb://127.0.0.1:27017/chevarxona

# Must be at least 32 characters — used to seal the session cookie
NUXT_SESSION_PASSWORD=change-this-to-a-long-random-string-min-32

# Bootstrap super admin (created on first boot when the users collection is empty)
SEED_ON_BOOT=true
SEED_ADMIN_EMAIL=admin@chevarxona.uz
SEED_ADMIN_PASSWORD=admin123

# Set to true for ONE boot to wipe business data and rebuild the demo workshop.
# Roles and the super admin survive; remember to set it back to false afterwards.
SEED_RESET=false

NUXT_PUBLIC_CURRENCY=UZS
